# Target database for ETL tasks.
# Use host.docker.internal if DB runs on host and Airflow runs in Docker.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_DATABASE=
DB_PORT=5432
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT_MILLIS=30000
DB_CONNECTION_TIMEOUT_MILLIS=10000

# Airflow - use host user UID so logs dir is writable
# Run: echo "AIRFLOW_UID=$(id -u)" >> .env
AIRFLOW_UID=50000

# Production: generate Fernet key for encrypted connections
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AIRFLOW__CORE__FERNET_KEY=<your-key>
